# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ivr_delivery

# --- API server ---
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Telephony: mock | twilio ---
TELEPHONY_PROVIDER=mock
MOCK_OUTCOME=received

# --- Twilio (required only when TELEPHONY_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Call queue (Redis + BullMQ) ---
REDIS_URL=redis://localhost:6379
CALL_QUEUE_CONCURRENCY=2
CALL_QUEUE_RATE_MAX=5
CALL_QUEUE_RATE_DURATION_MS=1000
CALL_RETRY_ATTEMPTS=3
CALL_RETRY_DELAY_MS=5000

# --- IVR content ---
COMPANY_NAME=YourCompanyName

# --- Webhook security ---
WEBHOOK_VALIDATION=true
