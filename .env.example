# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ivr_delivery

# --- API server ---
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000

# --- Telephony: mock | twilio ---
TELEPHONY_PROVIDER=mock
MOCK_OUTCOME=received

# --- Twilio (required only when TELEPHONY_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- IVR content ---
COMPANY_NAME=YourCompanyName

# --- Webhook security ---
WEBHOOK_VALIDATION=true
