# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ivr_delivery

# --- API server ---
PORT=4000
# Public HTTPS URL Twilio calls back into (no trailing slash). Use ngrok locally,
# your real API domain in production.
PUBLIC_BASE_URL=http://localhost:4000
# Server-to-server URL used by the Next.js dashboard proxy.
API_BASE_URL=http://localhost:4000

# --- Dashboard authentication ---
# Required in production. The browser never sees these values.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
# Origin of the deployed dashboard, used to restrict CORS.
WEB_ORIGIN=http://localhost:3000

# --- Telephony: mock | twilio ---
TELEPHONY_PROVIDER=mock
MOCK_OUTCOME=received

# --- Twilio (required only when TELEPHONY_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must be a Twilio-owned voice number, not a personal mobile (DNO restriction).
TWILIO_FROM_NUMBER=

# --- IVR content ---
COMPANY_NAME=YourCompanyName

# --- Webhook security ---
WEBHOOK_VALIDATION=true
